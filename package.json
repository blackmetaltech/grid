{
  "name": "grid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bridge": "vite build -c vite.bridge.config.ts",
    "typecheck": "tsc --noEmit",
    "lint:strings": "node scripts/lint-strings.mjs",
    "test": "vitest run",
    "smoke": "vite build -c vite.bridge.config.ts && godot --headless --path godot --import >/dev/null 2>&1; CB_SMOKE=1 godot --headless --path godot",
    "build:verify": "node scripts/build-verify.mjs",
    "fuzz:nightly": "node scripts/fuzz-nightly.mjs",
    "perf": "CB_PERF=1 vitest run src/perf.test.ts",
    "test:godot": "node scripts/test-godot.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
