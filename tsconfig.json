{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022"], "types": ["node"],
    "strict": true, "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "paths": { "@core/*": ["./core/ts/*"] }
  },
  "include": ["src", "*.ts"]
}
