; Engine configuration file (Godot 4.7). GRID, grid and 47901 are filled in by scaffold/new-game.sh; they work as literals too.
config_version=5

[application]

config/name="GRID"
config/version="1.13.0"
config/quit_on_go_back=false
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.05, 0.08, 1)

[cobanana]

engine_port="47901"
slug="grid"
; Online scores server (cobanana-scores); empty = offline. CB_SCORES_URL overrides.
scores_url=""

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.03, 0.05, 0.08, 1)

[internationalization]

locale/translations=PackedStringArray("res://locales/strings.en.translation")
locale/fallback="en"
